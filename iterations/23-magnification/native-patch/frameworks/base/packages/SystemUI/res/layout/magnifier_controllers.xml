<!-- Craftageddon modification: Ember Steel assets, responsive English labels and accessible control targets. -->
<FrameLayout xmlns:ns0="http://schemas.android.com/apk/res/android" ns0:layout_width="match_parent" ns0:layout_alignParentBottom="true" ns0:layout_alignParentEnd="true" ns0:layout_height="match_parent" ns0:gravity="center">

  <RelativeLayout ns0:layout_width="match_parent" ns0:layout_height="match_parent">

    <ImageView ns0:focusable="true" ns0:id="@+id/controller" ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns0:src="@drawable/ic_control_magnification_grey" />

    <View ns0:id="@+id/left_control" ns0:layout_width="@dimen/cg_mag_min_touch_target" ns0:layout_height="@dimen/cg_mag_min_touch_target" ns0:layout_alignLeft="@+id/controller" ns0:layout_centerVertical="true" />

    <View ns0:id="@+id/up_control" ns0:layout_width="@dimen/cg_mag_min_touch_target" ns0:layout_height="@dimen/cg_mag_min_touch_target" ns0:layout_alignTop="@+id/controller" ns0:layout_centerHorizontal="true" />

    <View ns0:id="@+id/right_control" ns0:layout_width="@dimen/cg_mag_min_touch_target" ns0:layout_height="@dimen/cg_mag_min_touch_target" ns0:layout_alignRight="@+id/controller" ns0:layout_centerVertical="true" />

    <View ns0:id="@+id/down_control" ns0:layout_width="@dimen/cg_mag_min_touch_target" ns0:layout_height="@dimen/cg_mag_min_touch_target" ns0:layout_alignBottom="@+id/controller" ns0:layout_centerHorizontal="true" />
  </RelativeLayout>

</FrameLayout>
