<resources>
    <!-- Settings activity theme. -->
    <style name="Theme.SettingsLib" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="android:colorBackground">#080c11</item>
        <item name="colorPrimary">#e56620</item>
        <item name="colorOnPrimary">#120d09</item>
        <item name="colorPrimaryContainer">#322216</item>
        <item name="colorOnPrimaryContainer">#eee7d9</item>
        <item name="colorSecondary">#b5bdc6</item>
        <item name="colorOnSecondary">#080c11</item>
        <item name="colorSecondaryContainer">#202c37</item>
        <item name="colorOnSecondaryContainer">#eee7d9</item>
        <item name="colorSurface">#10151b</item>
        <item name="colorOnSurface">#eee7d9</item>
        <item name="colorOnSurfaceVariant">#b5bdc6</item>
        <item name="colorSurfaceVariant">#1b2732</item>
        <item name="colorSurfaceBright">#17212a</item>
        <item name="colorSurfaceContainerLowest">#080c11</item>
        <item name="colorSurfaceContainerLow">#10151b</item>
        <item name="colorSurfaceContainer">#10151b</item>
        <item name="colorSurfaceContainerHigh">#17212a</item>
        <item name="colorSurfaceContainerHighest">#1b2732</item>
        <item name="colorOutline">#596571</item>
        <item name="colorError">#ff8585</item>
        <item name="colorOnError">#240b0c</item>
        <item name="colorControlActivated">#e56620</item>
        <item name="android:textColorPrimary">#eee7d9</item>
        <item name="android:textColorSecondary">#b5bdc6</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:listPreferredItemPaddingLeft">24dp</item>
        <item name="android:listPreferredItemPaddingStart">24dp</item>
        <item name="alertDialogTheme">@style/Theme.SettingsLib.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.SettingsLib.AlertDialog</item>
        <item name="materialSwitchStyle">@style/Widget.SettingsLib.MaterialSwitch</item>
        <item name="preferenceTheme">@style/Theme.SettingsLib.PreferenceTheme</item>
    </style>

    <!-- Settings alert dialog theme. -->
    <style name="Theme.SettingsLib.AlertDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="dialogCornerRadius">16dp</item>
    </style>

    <!-- Settings preference style. -->
    <style name="Theme.SettingsLib.PreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listPreferredItemPaddingLeft">32dp</item>
        <item name="android:listPreferredItemPaddingStart">32dp</item>
        <item name="android:tint">?attr/colorOnSurface</item>
        <item name="switchPreferenceCompatStyle">@style/Theme.SettingsLib.SwitchPreferenceCompat
        </item>
        <item name="switchPreferenceStyle">@style/Theme.SettingsLib.SwitchPreference</item>
    </style>

    <style name="Theme.SettingsLib.SwitchPreference" parent="@style/Preference.SwitchPreference.Material">
        <item name="widgetLayout">@layout/settingslib_switch</item>
    </style>

    <style name="Theme.SettingsLib.SwitchPreferenceCompat" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/settingslib_switch_compat</item>
    </style>

    <!-- MaterialSwitch style -->
    <style name="Widget.SettingsLib.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbIcon">@drawable/settingslib_switch_thumb_icon</item>
        <item name="thumbIconTint">@color/settingslib_switch_thumb_icon</item>
    </style>
</resources>
